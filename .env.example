ELEVENLABS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DISCORD_BOT_TOKEN=

# 主席發言預設仍使用 ElevenLabs。改成 azure 時，STT 仍需要上面的 ElevenLabs key。
AHEM_TTS_PROVIDER=elevenlabs
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# female = 1 號小辰；male = 5 號雲哲。進階用法才需以 AZURE_TTS_VOICE 覆寫。
AZURE_TTS_GENDER=female
# AZURE_TTS_VOICE=
AZURE_TTS_RATE=+12%
AZURE_TTS_MONTHLY_LIMIT=500000
# 保留 5% 計量緩衝；達 475,000 字元就停止送出 Azure TTS 請求。
AZURE_TTS_HARD_STOP_PERCENT=95
AZURE_TTS_WARNING_PERCENTS=80,90,95
AZURE_TTS_USAGE_FILE=meetings/azure_tts_usage.json

# ── 部署環境（每台機器自己填，不要進版控）──────────────────────────
# 觀戰畫面對外的 base URL。部署機器走反向代理／tunnel 時填它的主機名，
# 啟動橫幅與貼進 Discord 的網址都會用這個值。沒設就退回 http://localhost:<port>，
# 並在啟動時明講「這是本機網址」——安靜地印 localhost 會讓人把死網址交出去。
# 例：AHEM_PUBLIC_URL=https://your-host.example.com
AHEM_PUBLIC_URL=
# 預設要加入的 Discord 語音頻道 ID（`--channel` 留空時用它）。
# 頻道 ID 屬於部署環境，不要寫進文件或指令——這個 repo 是公開的。
AHEM_CHANNEL_ID=
