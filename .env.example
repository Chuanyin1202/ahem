ELEVENLABS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DISCORD_BOT_TOKEN=
AHEM_VIEWER_TOKEN=
AHEM_OPERATOR_TOKEN=
AHEM_TRUSTED_ORIGINS=
# redacted = 真實會議預設；full 還必須搭配 AHEM_DEMO_PUBLIC_TRANSCRIPT=1。
AHEM_VIEWER_CONTENT=redacted
AHEM_DEMO_PUBLIC_TRANSCRIPT=0
# Raspberry Pi/Linux：指向 root 所有、0600 的 base64 32-byte KEK 檔案。
AHEM_KEK_FILE=
AHEM_SECURE_STORAGE=1
AHEM_COOKIE_SECURE=1
AHEM_DISABLE_WEB_SEARCH=1

# 主席發言預設仍使用 ElevenLabs。改成 azure 時，STT 仍需要上面的 ElevenLabs key。
AHEM_TTS_PROVIDER=elevenlabs
# ElevenLabs 主席聲線：可填單一覆寫 ID，或分別提供男女聲 ID。
ELEVENLABS_TTS_GENDER=female
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_FEMALE_VOICE_ID=
ELEVENLABS_TTS_MALE_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v3_conversational
ELEVENLABS_TTS_LANGUAGE=zh
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# female = 1 號小辰；male = 5 號雲哲。進階用法才需以 AZURE_TTS_VOICE 覆寫。
AZURE_TTS_GENDER=female
# AZURE_TTS_VOICE=
AZURE_TTS_RATE=+12%
AZURE_TTS_MONTHLY_LIMIT=500000
# 保留 5% 計量緩衝；達 475,000 字元就停止送出 Azure TTS 請求。
AZURE_TTS_HARD_STOP_PERCENT=95
AZURE_TTS_WARNING_PERCENTS=80,90,95
AZURE_TTS_USAGE_FILE=meetings/azure_tts_usage.json
