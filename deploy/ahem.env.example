# 複製到 /etc/ahem/ahem.env，由 root 填值後 chmod 600。不要提交真實值。
DISCORD_BOT_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_GENDER=female
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_FEMALE_VOICE_ID=
ELEVENLABS_TTS_MALE_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v3_conversational
ELEVENLABS_TTS_LANGUAGE=zh
OPENAI_API_KEY=

AHEM_VIEWER_TOKEN=
AHEM_OPERATOR_TOKEN=
AHEM_TRUSTED_ORIGINS=https://ahem.example.com
AHEM_VIEWER_CONTENT=redacted
AHEM_DEMO_PUBLIC_TRANSCRIPT=0
AHEM_SECURE_STORAGE=1
AHEM_COOKIE_SECURE=1
AHEM_DISABLE_WEB_SEARCH=1

# 主席 TTS：elevenlabs 或 azure。STT 不論哪種都仍使用 ElevenLabs。
AHEM_TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_TTS_GENDER=female
AZURE_TTS_RATE=+12%
AZURE_TTS_MONTHLY_LIMIT=500000
AZURE_TTS_HARD_STOP_PERCENT=95
AZURE_TTS_WARNING_PERCENTS=80,90,95
AZURE_TTS_USAGE_FILE=/var/lib/ahem/meetings/azure_tts_usage.json

AHEM_TOPIC=FUTURE 黑客松 Demo
AHEM_DURATION_MIN=10
AHEM_DISCORD_CHANNEL=REPLACE_WITH_NUMERIC_CHANNEL_ID
